# Contrigent Agent
#
# Copy this file to .env when local credentials are eventually required.
# Never place real secrets in this file.

NODE_ENV=development

# Added later when the agent integration is implemented:
# OPENAI_API_KEY=

# Added later when PostgreSQL is introduced:
# DATABASE_URL=

# Added later when Redis is introduced:
# REDIS_URL=

# Added later when the GitHub App is introduced:
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GitHub REST API authentication.
# Fine-grained token needs Pull requests: write
# for repositories Contrigent will create draft PRs in.
GITHUB_TOKEN=